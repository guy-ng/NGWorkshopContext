        <di:waypoint x="870" y="298" />
        <di:waypoint x="870" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CfoToEnd_di" bpmnElement="Flow_CfoToEnd">
        <di:waypoint x="920" y="380" />
        <di:waypoint x="940" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DecisionMade_di" bpmnElement="Flow_DecisionMade">
        <di:waypoint x="920" y="240" />
        <di:waypoint x="980" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DecisionApproved_di" bpmnElement="Flow_DecisionApproved">
