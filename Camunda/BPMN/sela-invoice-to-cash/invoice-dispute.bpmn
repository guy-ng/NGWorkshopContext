        <bpmndi:BPMNLabel>
          <dc:Bounds x="605" y="216" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RouteManagerReview_di" bpmnElement="Flow_RouteManagerReview">
        <di:waypoint x="585" y="265" />
        <di:waypoint x="585" y="500" />
        <di:waypoint x="660" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="592" y="476" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WarehouseChecked_di" bpmnElement="Flow_WarehouseChecked">
        <di:waypoint x="760" y="240" />
        <di:waypoint x="820" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClaimJustified_di" bpmnElement="Flow_ClaimJustified">
        <di:waypoint x="845" y="215" />
        <di:waypoint x="845" y="120" />
        <di:waypoint x="960" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="852" y="140" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClaimRejected_di" bpmnElement="Flow_ClaimRejected">
        <di:waypoint x="845" y="265" />
        <di:waypoint x="845" y="300" />
        <di:waypoint x="920" y="300" />
        <di:waypoint x="920" y="620" />
        <di:waypoint x="960" y="620" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="852" y="276" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SlaBreach_di" bpmnElement="Flow_SlaBreach">
        <di:waypoint x="710" y="298" />
        <di:waypoint x="710" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SlaToEnd_di" bpmnElement="Flow_SlaToEnd">
        <di:waypoint x="760" y="380" />
        <di:waypoint x="880" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerDecided_di" bpmnElement="Flow_ManagerDecided">
        <di:waypoint x="760" y="500" />
        <di:waypoint x="820" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproved_di" bpmnElement="Flow_ManagerApproved">
        <di:waypoint x="870" y="500" />
        <di:waypoint x="940" y="500" />
        <di:waypoint x="940" y="120" />
        <di:waypoint x="960" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="476" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
