    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CanEnterBuilding_Yes" name="כן" sourceRef="Gateway_CanEnterBuilding" targetRef="Gateway_ChooseProtectedSpace" />
    <bpmn:sequenceFlow id="Flow_CanEnterBuilding_No" name="לא" sourceRef="Gateway_CanEnterBuilding" targetRef="Task_LieDownAndProtectHead" />
    <bpmn:task id="Task_LieDownAndProtectHead" name="שכב על הקרקע והגן על הראש">
