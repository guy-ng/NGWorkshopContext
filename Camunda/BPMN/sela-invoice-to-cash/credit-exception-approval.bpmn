        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RouteAutoReject_di" bpmnElement="Flow_RouteAutoReject">
        <di:waypoint x="745" y="265" />
