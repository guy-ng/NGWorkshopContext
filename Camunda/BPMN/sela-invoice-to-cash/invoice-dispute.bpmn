        <dc:Bounds x="400" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DisputeRoute_di" bpmnElement="Gateway_DisputeRoute" isMarkerVisible="true">
