---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ngLogo from '../../../assets/ng-logo.png';
import camundaVideo from '../../../assets/camunda-video.png';
import Icon from '../../../components/Icon.astro';

export function getStaticPaths() {
  return ['camunda', 'vibe-coding-rescue'].map((service) => ({ params: { service } }));
}

const service = Astro.params.service;
const camunda = service === 'camunda';

const title = camunda ? 'Camunda in Israel | NG Workshop' : 'Vibe Coding Rescue | NG Workshop';
const description = camunda
  ? 'Official Camunda partners in Israel: Camunda 8 implementation, migration, process orchestration and AI agent integration.'
  : 'Audit and rescue for apps built with Lovable, Bolt, Cursor, Replit or Claude Code.';

const capabilities = [
  ['End-to-end orchestration', 'One process, every actor', 'A single process connecting core systems, external services, human tasks and AI agents.', ['Camunda 8', 'BPMN 2.0', 'Zeebe']],
  ['BPMN as a shared language', 'Business and engineering aligned', 'The same diagram serves business people and developers — no translation, no gaps.', ['BPMN 2.0', 'DMN', 'Modeler']],
  ['Agentic orchestration', 'AI agents inside the process', 'We put AI agents inside the business process — with decision points, human approvals and control. The agent runs within clear boundaries and is measured like any other step.', ['AI Agents', 'Human-in-the-Loop', 'Camunda 8']],
  ['Monitoring & optimization', 'Measure and improve', 'Cycle times, bottlenecks and exceptions measured — and improved continuously from the data.', ['Operate', 'Optimize', 'Tasklist']],
];
const failures = [
  ['Broken access control', 'The user-A-reads-user-B’s-data bug: row-level security left off, missing authorization checks, and client-side auth anyone can skip.'],
  ['Secrets in the open', 'API keys committed to the repo, staging and production sharing one database, and logs leaking tokens and personal data.'],
  ['Payments that lie', 'Webhook handling, refunds and subscription state that look right in a demo — and quietly drop money in production.'],
];
const rescueOptions = [
  ['Vibe Code Audit', 'Fixed-scope code audit', 'A mapped architecture review, findings ranked by severity, and a clear recommendation. Usually a few days, and useful on its own.', ['A few days', 'Findings report', 'Fixed scope']],
  ['Full Rescue', 'Production-ready recovery', 'We close security holes, fix payments, add regression tests, and establish CI and observability. You get a version safe for real users.', ['A few weeks', 'Regression tests', 'CI & observability']],
];
const rescueSteps = [
  ['01', 'Audit', 'We read the code, map the architecture, and scan for security, data and scaling gaps.'],
  ['02', 'Triage', 'We rank findings by severity and give an honest keep-versus-rebuild call.'],
  ['03', 'Harden', 'We close broken access control, leaking secrets, payments and unhappy paths.'],
  ['04', 'Test', 'A regression suite that stops the next AI edit from breaking things silently.'],
  ['05', 'Ship', 'CI, observability and rollbacks, so failures surface early.'],
  ['06', 'Handover', 'Runbooks and a walkthrough — it is your code, and you operate it.'],
];
const checklist = ['Authorization on every endpoint', 'Input validation and unhappy paths', 'Secrets and environments — keys out of the repo, staging split from production', 'Error handling that fails closed', 'Observability, logs and rollbacks', 'A regression test suite'];
const tools = ['Lovable', 'Bolt', 'Cursor', 'Replit', 'v0', 'Windsurf', 'Claude Code', 'ChatGPT', 'Supabase', 'Firebase', 'Next.js', 'Vercel'];
---
<BaseLayout locale="en" title={title} description={description}>
  {camunda ? (
    <>
      <section class="service-hero section"><div class="shell centered"><div class="partner-lockup"><Image src={ngLogo} width={197} height={22} densities={[1, 2]} loading="eager" alt="NG Workshop" /><span>×</span><img src="/images/camunda-wordmark.svg" width="99" height="34" alt="Camunda" /></div><img class="gold-badge" src="/images/camunda-gold.svg" width="146" height="48" alt="Camunda Gold Partner Certified" /><h1>Camunda in Israel — end-to-end process orchestration</h1><p>Official Camunda partners in Israel. We implement Camunda 8, migrate off legacy engines, and connect systems, people and AI agents into one visible, measurable process.</p><div class="actions"><a class="button" href="#contact">Talk to us about Camunda</a><a class="button outline" href="#video">Watch the video</a></div></div></section>
      <section id="video" class="section video-section"><div class="shell centered light-text"><h2>Universal process orchestration and automation with Camunda, end to end</h2><p>A full walkthrough of the platform, the orchestration architecture, and the path from a business process to a system running in production.</p><a class="video" href="https://youtube.com/watch?v=m6xY-lNaI1U"><Image src={camundaVideo} width={1280} height={720} loading="lazy" alt="Camunda platform walkthrough" /><span class="play-icon"><Icon name="play" /></span></a><small>youtube.com/watch?v=m6xY-lNaI1U</small></div></section>
      <section class="section"><div class="shell section-heading"><span class="badge">The Platform</span><h2>What is Camunda</h2><p>Camunda is an open-source process orchestration platform. It lets you describe a business process in BPMN 2.0 and actually run it — across systems, services, people and AI agents. Instead of logic scattered through dozens of microservices, you get one process that is visible, measurable and changeable.</p></div></section>
      <section class="section white"><div class="shell"><div class="section-heading"><span class="badge">What We Do</span><h2>What we do with Camunda</h2></div><div class="cards">{capabilities.map(([name, label, copy, tags]) => <article class="service-card card"><span class="icon-tile"><Icon name="cycle" /></span><h3>{name}</h3><strong>{label}</strong><p>{copy}</p><div class="chips">{(tags as string[]).map(tag => <span>{tag}</span>)}</div></article>)}</div></div></section>
      <section class="section"><div class="shell"><div class="section-heading"><span class="badge">Proven Impact</span><h2>The numbers speak for themselves</h2><p>Based on the Forrester Total Economic Impact study for Camunda.</p></div><div class="stats"><div><b>+20,000</b><span>Developer hours saved</span></div><div><b>$15M</b><span>Process-quality savings</span></div><div><b>389%</b><span>Return on Investment (ROI)</span></div></div></div></section>
    </>
  ) : (
    <>
      <section class="service-hero section"><div class="shell centered"><span class="badge">Vibe Coding Rescue</span><h1>Fix your AI-built app before it breaks</h1><p>Built with Lovable, Bolt, Cursor, Replit or Claude Code and now it breaks where it counts? We read the code the model never did, close the security and data holes, add tests, and hand back a version safe for real users.</p><strong>Fixed scope · Senior engineers · No rewrite for the sake of it</strong><div class="actions"><a class="button" href="#contact">Book a code audit</a><a class="button outline" href="#contact">Talk to us</a></div></div></section>
      <section class="section white"><div class="shell"><div class="section-heading"><span class="badge">What Breaks</span><h2>What breaks in AI-built apps</h2><p>The demo works — and that is exactly the trap. Failures show up where a demo never looks: authorization, data access, payments, and the unhappy paths.</p></div><div class="stat-callout"><b>45% of AI-generated code introduces a security vulnerability</b><small>Veracode, 2025</small></div><div class="cards three">{failures.map(([name, copy]) => <article class="failure card"><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>
      <section class="section"><div class="shell"><div class="section-heading"><span class="badge">Two Ways In</span><h2>Two ways in</h2><p>We always start with an audit, not a rewrite. After it you know exactly what has to be fixed — and what can stay.</p></div><div class="cards">{rescueOptions.map(([name, label, copy, tags]) => <article class="service-card card"><span class="icon-tile"><Icon name="check" /></span><h3>{name}</h3><strong>{label}</strong><p>{copy}</p><div class="chips">{(tags as string[]).map(tag => <span>{tag}</span>)}</div></article>)}</div></div></section>
      <section class="section dark"><div class="shell"><div class="section-heading"><span class="badge">The Rescue</span><h2>How a rescue runs</h2><p>Six steps, in this order. Critical security fixes ship first.</p></div><div class="steps">{rescueSteps.map(([num, name, copy]) => <article><b>{num}</b><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>
      <section class="section white"><div class="shell rescue-grid"><div><span class="badge">Production Ready</span><h2>What a rescue covers</h2><p>The production-readiness checklist we work through on every project.</p><ul>{checklist.map(item => <li><span class="check-icon"><Icon name="check" /></span><span>{item}</span></li>)}</ul></div><aside class="card"><h3>An honest keep-versus-rebuild call</h3><p>We do not rewrite for the sake of it. If the generated code is structurally sound, we harden it and move on.</p><h3>Handover, not lock-in</h3><p>Every rescue ends with docs, tests and a walkthrough, so your team can run and extend it.</p></aside></div></section>
      <section class="section"><div class="shell"><div class="section-heading"><span class="badge">Tool Agnostic</span><h2>Tools we rescue from</h2></div><div class="tool-cloud">{tools.map(tool => <span>{tool}</span>)}</div></div></section>
    </>
  )}
</BaseLayout>

<style>
  .centered{display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px}.service-hero{padding-block:96px}.service-hero h1{max-width:900px;font-size:44px;line-height:1.2}.service-hero p{max-width:780px;color:var(--muted);font-size:18px}.partner-lockup{display:flex;align-items:center;gap:20px}.partner-lockup img:first-child{width:197px}.partner-lockup img:last-child{width:99px}.partner-lockup span{font-size:28px;color:var(--muted)}.gold-badge{width:195px}.video-section,.dark{background:var(--dark);color:#efebe4}.light-text h2{max-width:820px;font-size:32px}.light-text>p{max-width:760px;color:#d2cbc2;font-size:18px}.video{position:relative;display:block;width:min(900px,100%);aspect-ratio:16/9;border-radius:16px;overflow:hidden}.video img{width:100%;height:100%;object-fit:cover}.video .play-icon{position:absolute;inset:50% auto auto 50%;translate:-50% -50%;display:grid;place-items:center;width:88px;height:88px;border-radius:50%;background:var(--primary);color:#1c2609;font-size:30px}.white{background:white}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.cards.three{grid-template-columns:repeat(3,1fr)}.chips{display:flex;flex-wrap:wrap;gap:8px}.chips span,.tool-cloud span{padding:4px 12px;border:1px solid var(--border);border-radius:999px;background:var(--paper);color:var(--muted);font-size:14px}.failure{padding:28px}.failure p{color:var(--muted)}.stat-callout{display:flex;flex-direction:column;align-items:center;gap:6px;width:max-content;max-width:100%;margin:0 auto 40px;padding:28px 40px;border-radius:16px;background:var(--primary-soft);text-align:center}.stat-callout b{font-size:28px}.stat-callout small{color:var(--muted)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.steps article{padding:28px;border:1px solid #efebe433;border-radius:16px}.steps b{color:var(--primary);font-size:28px}.steps p,.dark .section-heading p{color:#d2cbc2}.rescue-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center}.rescue-grid>div{display:flex;flex-direction:column;align-items:flex-start;gap:16px}.rescue-grid>div>p,.rescue-grid aside p{color:var(--muted)}.rescue-grid ul{display:grid;gap:12px;margin:8px 0 0;padding:0;list-style:none}.rescue-grid li{display:flex;align-items:flex-start;gap:10px}.rescue-grid .check-icon{display:inline-grid;place-items:center;width:24px;height:24px;flex:0 0 24px;border-radius:50%;background:var(--primary-soft);color:#527b18;font-size:16px}.rescue-grid aside{padding:32px;display:grid;gap:12px}.rescue-grid aside h3+ p{margin-bottom:16px}.tool-cloud{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:760px;margin:auto}.tool-cloud span{padding:8px 18px;background:white}.service-card .icon-tile{font-size:24px}.service-card strong{color:#1c2609}.stats{margin-inline:auto}
  @media(max-width:900px){.service-hero{padding-block:64px}.service-hero h1{font-size:38px}.cards,.cards.three,.steps,.rescue-grid{grid-template-columns:1fr}.steps{gap:16px}.rescue-grid{gap:32px}.video span{width:64px;height:64px}.partner-lockup img:first-child{width:161px}.section-heading{margin-bottom:40px}}
  @media(max-width:520px){.service-hero h1{font-size:34px}.service-hero .actions{width:100%}.service-hero .button{width:100%}.partner-lockup{gap:12px}.partner-lockup img:first-child{width:150px}.partner-lockup img:last-child{width:82px}.stat-callout{padding:24px}.stat-callout b{font-size:23px}.service-card,.failure,.steps article{padding:24px}.video-section{padding-block:64px}.light-text h2{font-size:28px}}
</style>
