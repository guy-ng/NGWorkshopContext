---
import ServiceIcon from './ServiceIcon.astro';
import Icon from './Icon.astro';
import type { Locale } from '../lib/i18n';
const { locale } = Astro.props as { locale: Locale };
const he = locale === 'he';
---
<section class="page-hero services-hero">
  <div class="shell">
    <span class="badge">{he ? 'השירותים שלנו' : 'Our services'}</span>
    <h1>{he ? 'מומחיות שמגיעה עד הייצור' : 'Expertise that reaches production'}</h1>
    <p>{he ? 'שני מסלולים ממוקדים לפתרון האתגרים שמעסיקים ארגונים וצוותי מוצר עכשיו.' : 'Two focused practices for the challenges facing organizations and product teams right now.'}</p>
  </div>
</section>

<section class="section services-directory">
  <div class="shell service-links">
    <a class="service-link card camunda-card" href={`/${locale}/services/camunda/`}>
      <div class="service-brand">
        <img src="/images/camunda-wordmark.svg" width="99" height="34" alt="Camunda" />
        <img src="/images/camunda-gold.svg" width="146" height="48" alt="Camunda Gold Partner Certified" />
      </div>
      <span class="badge">Process Orchestration</span>
      <h2>{he ? 'Camunda בישראל' : 'Camunda in Israel'}</h2>
      <p>{he ? 'יישום Camunda 8, מיגרציה ממנועים ותיקים ותזמור מערכות, אנשים וסוכני AI בתהליך אחד גלוי ונמדד.' : 'Camunda 8 implementation, legacy migration, and orchestration across systems, people and AI agents.'}</p>
      <strong dir={he ? 'rtl' : 'ltr'}><span>{he ? 'לעמוד Camunda' : 'Explore Camunda'}</span><span class="link-arrow"><Icon name={he ? 'arrow-left' : 'arrow-right'} /></span></strong>
    </a>

    <a class="service-link card vibe-card" href={`/${locale}/services/vibe-coding-rescue/`}>
      <ServiceIcon icon="rescue" />
      <span class="badge">Vibe Coding Rescue</span>
      <h2>{he ? 'חילוץ אפליקציות שנבנו ב-AI' : 'Rescue AI-built applications'}</h2>
      <p>{he ? 'בדיקת קוד, אבטחה, תשלומים, בדיקות רגרסיה ו-CI — כדי להפוך אב־טיפוס מרשים למוצר בטוח למשתמשים אמיתיים.' : 'Code review, security, payments, regression tests and CI—turning an impressive prototype into dependable software.'}</p>
      <strong dir={he ? 'rtl' : 'ltr'}><span>{he ? 'לעמוד Vibe Coding Rescue' : 'Explore Vibe Coding Rescue'}</span><span class="link-arrow"><Icon name={he ? 'arrow-left' : 'arrow-right'} /></span></strong>
    </a>
  </div>
</section>

<style>
  .services-hero { padding-bottom: 64px; }
  .services-directory { padding-top: 24px; }
  .service-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .service-link { display: flex; min-height: 440px; flex-direction: column; align-items: flex-start; gap: 18px; padding: 40px; overflow: hidden; transition: transform .2s, box-shadow .2s, border-color .2s; }
  [dir='rtl'] .service-link { align-items: flex-end; text-align: right; }
  .service-link:hover { transform: translateY(-5px); border-color: var(--primary); box-shadow: var(--shadow); }
  .service-link h2 { font-size: 36px; }
  .service-link p { color: var(--muted); font-size: 18px; }
  .service-link strong { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; color: #527b18; unicode-bidi: isolate; }
  .link-arrow { direction: ltr; line-height: 1; transition: transform .2s; }
  .service-link:hover .link-arrow { transform: translateX(3px); }
  [dir='rtl'] .service-link:hover .link-arrow { transform: translateX(-3px); }
  .service-brand { display: flex; width: 100%; min-height: 64px; align-items: center; justify-content: space-between; gap: 24px; }
  .service-brand img:first-child { width: 120px; height: auto; }
  .service-brand img:last-child { width: 146px; height: 48px; }
  @media (max-width: 760px) { .service-links { grid-template-columns: 1fr; } .service-link { min-height: 380px; padding: 28px; } .service-link h2 { font-size: 30px; } }
</style>
