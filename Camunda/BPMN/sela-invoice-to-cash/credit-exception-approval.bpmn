          <dc:Bounds x="130" y="265" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HoldOrder_di" bpmnElement="Task_HoldOrder">
