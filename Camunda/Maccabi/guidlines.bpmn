    <bpmn:sequenceFlow id="Flow_CanReachBuilding_No" name="לא" sourceRef="Gateway_CanReachBuilding" targetRef="Task_ExitCarAndLieDown" />
    <bpmn:task id="Task_ExitCarAndLieDown" name="צא מהרכב, התרחק, שכב והגן על הראש">
