---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ngLogo from '../../../assets/ng-logo.png';
import camundaVideo from '../../../assets/camunda-video.png';
import Icon from '../../../components/Icon.astro';

export function getStaticPaths() {
  return ['camunda', 'vibe-coding-rescue'].map((service) => ({ params: { service } }));
}

const service = Astro.params.service;
const camunda = service === 'camunda';

const title = camunda ? 'Camunda בישראל | NG Workshop' : 'חילוץ אפליקציות Vibe Coding | NG Workshop';
const description = camunda
  ? 'שותפי Camunda רשמיים בישראל: יישום Camunda 8, מיגרציה, תזמור תהליכים ושילוב סוכני AI.'
  : 'בדיקה וחילוץ של אפליקציות שנבנו ב-Lovable, Bolt, Cursor, Replit או Claude Code.';

const capabilities = [
  ['End-to-end orchestration', 'תזמור מקצה לקצה', 'תהליך אחד שמחבר מערכות ליבה, שירותים חיצוניים, משימות אנוש וסוכני AI.', ['Camunda 8', 'BPMN 2.0', 'Zeebe']],
  ['BPMN as a shared language', 'שפה משותפת', 'אותה דיאגרמה משמשת את אנשי העסקים ואת המפתחים — בלי תרגום ובלי פערים.', ['BPMN 2.0', 'DMN', 'Modeler']],
  ['Agentic orchestration', 'תזמור סוכני AI', 'משלבים סוכני AI בתוך התהליך העסקי — עם נקודות החלטה, אישורי אנוש ובקרה. הסוכן פועל בתוך גבולות ברורים ונמדד כמו כל שלב אחר.', ['AI Agents', 'Human-in-the-Loop', 'Camunda 8']],
  ['Monitoring & optimization', 'ניטור ואופטימיזציה', 'מדידת זמני מחזור, צווארי בקבוק וחריגות — ושיפור מתמשך על בסיס נתונים.', ['Operate', 'Optimize', 'Tasklist']],
];

const failures = [
  ['בקרת גישה שבורה', 'המשתמש א׳ קורא את המידע של משתמש ב׳: הרשאות ברמת שורה שכבויות, בדיקות הרשאה חסרות, ואימות בצד הלקוח שכל אחד יכול לעקוף.'],
  ['סודות חשופים', 'מפתחות API שנשמרו ב-repo, סביבת בדיקות וייצור שחולקות מסד נתונים אחד, ולוגים שמדליפים טוקנים ומידע אישי.'],
  ['תשלומים ששקרו', 'טיפול ב-webhooks, זיכויים ומצב מנוי שנראים תקינים בדמו — ובשקט מאבדים כסף בייצור.'],
];

const rescueOptions = [
  ['Vibe Code Audit', 'בדיקת קוד בהיקף קבוע', 'סקירה ממופה של הארכיטקטורה, עם ממצאים מדורגים לפי חומרה והמלצה ברורה. בדרך כלל כמה ימים, ועומדת בפני עצמה.', ['כמה ימים', 'דוח ממצאים', 'היקף קבוע']],
  ['Full Rescue', 'חילוץ מלא עד ייצור', 'סוגרים פרצות אבטחה, מתקנים תשלומים, מוסיפים חבילת בדיקות רגרסיה ומקימים CI וניטור. מחזירים גרסה בטוחה למשתמשים.', ['כמה שבועות', 'בדיקות רגרסיה', 'CI וניטור']],
];

const rescueSteps = [
  ['01', 'בדיקה · Audit', 'קוראים את הקוד, ממפים את הארכיטקטורה וסורקים פערי אבטחה, נתונים וסקיילביליות.'],
  ['02', 'תעדוף · Triage', 'מדרגים ממצאים לפי חומרה, ונותנים הערכה כנה: לשמר או לבנות מחדש.'],
  ['03', 'חיזוק · Harden', 'סוגרים בקרת גישה שבורה, סודות דולפים, תשלומים ומסלולים חריגים.'],
  ['04', 'בדיקות · Test', 'חבילת רגרסיה שמונעת שבירה שקטה בעריכות ה-AI הבאות.'],
  ['05', 'עלייה לאוויר · Ship', 'CI, ניטור ו-rollback לזיהוי מוקדם של תקלות.'],
  ['06', 'מסירה · Handover', 'Runbooks והדרכה — הקוד שלכם, ואתם מפעילים אותו.'],
];

const checklist = ['הרשאות בכל endpoint', 'ולידציה של קלט ומסלולים חריגים', 'סודות וסביבות — מפתחות מחוץ ל-repo, הפרדת staging וייצור', 'טיפול בשגיאות שחוסם גישה כברירת מחדל (fail-closed)', 'ניטור, לוגים ו-rollback', 'חבילת בדיקות רגרסיה'];
const tools = ['Lovable', 'Bolt', 'Cursor', 'Replit', 'v0', 'Windsurf', 'Claude Code', 'ChatGPT', 'Supabase', 'Firebase', 'Next.js', 'Vercel'];
---
<BaseLayout locale="he" title={title} description={description}>
  {camunda ? (
    <>
      <section class="service-hero section">
        <div class="shell centered">
          <div class="partner-lockup"><img src="/images/camunda-wordmark.svg" width="99" height="34" alt="Camunda" /><span>×</span><Image src={ngLogo} width={197} height={22} densities={[1, 2]} loading="eager" alt="NG Workshop" /></div>
          <img class="gold-badge" src="/images/camunda-gold.svg" width="146" height="48" alt="Camunda Gold Partner Certified" />
          <h1>Camunda בישראל — תזמור תהליכים מקצה לקצה</h1>
          <p>שותפי Camunda רשמיים בישראל. מיישמים Camunda 8, מבצעים מיגרציה ממנועים ותיקים, ומחברים מערכות, אנשים וסוכני AI לתהליך אחד גלוי ונמדד.</p>
          <div class="actions"><a class="button" href="#contact">דברו איתנו על Camunda</a><a class="button outline" href="#video">צפו בסרטון</a></div>
        </div>
      </section>
      <section id="video" class="section video-section">
        <div class="shell centered light-text"><h2>תזמור ואוטומציה אוניברסלית של תהליכים עם Camunda מקצה לקצה</h2><p>הסבר מלא על הפלטפורמה, ארכיטקטורת התזמור והדרך מהתהליך העסקי למערכת שרצה בייצור.</p><a class="video" href="https://youtube.com/watch?v=m6xY-lNaI1U"><Image src={camundaVideo} width={1280} height={720} loading="lazy" alt="סרטון סקירה על Camunda" /><span class="play-icon"><Icon name="play" /></span></a><small>youtube.com/watch?v=m6xY-lNaI1U</small></div>
      </section>
      <section class="section"><div class="shell section-heading"><span class="badge">The Platform</span><h2>מה זה Camunda</h2><p>Camunda היא פלטפורמת תזמור תהליכים בקוד פתוח, שמאפשרת לתאר תהליך עסקי בתקן BPMN 2.0 ולהריץ אותו בפועל — מעל מערכות, שירותים, אנשים וסוכני AI. במקום לוגיקה שמפוזרת בין עשרות מיקרו-שירותים, מקבלים תהליך אחד גלוי, נמדד וניתן לשינוי.</p></div></section>
      <section class="section white"><div class="shell"><div class="section-heading"><span class="badge">What We Do</span><h2>מה אנחנו עושים עם Camunda</h2></div><div class="cards">{capabilities.map(([name, label, copy, tags]) => <article class="service-card card"><span class="icon-tile"><Icon name="cycle" /></span><h3>{name}</h3><strong>{label}</strong><p>{copy}</p><div class="chips">{(tags as string[]).map(tag => <span>{tag}</span>)}</div></article>)}</div></div></section>
      <section class="section"><div class="shell"><div class="section-heading"><span class="badge">Proven Impact</span><h2>המספרים מדברים בעד עצמם</h2><p>מבוסס על מחקר Forrester Total Economic Impact עבור Camunda.</p></div><div class="stats"><div><b>+20,000</b><span>שעות פיתוח שנחסכו</span></div><div><b>$15M</b><span>חיסכון באיכות תהליכים</span></div><div><b>389%</b><span>החזר השקעה (ROI)</span></div></div></div></section>
    </>
  ) : (
    <>
      <section class="service-hero section"><div class="shell centered"><span class="badge">Vibe Coding Rescue</span><h1>חילוץ אפליקציות שנבנו ב-Vibe Coding</h1><p>בניתם ב-Lovable, Bolt, Cursor, Replit או Claude Code — והמערכת נשברת בדיוק במקומות הקריטיים? אנחנו קוראים את הקוד שהמודל לא קרא, סוגרים פרצות אבטחה ודליפות מידע, מוסיפים בדיקות ומחזירים גרסה בטוחה למשתמשים אמיתיים.</p><strong>היקף עבודה קבוע · מהנדסים בכירים · בלי כתיבה מחדש סתם</strong><div class="actions"><a class="button" href="#contact">קבעו בדיקת קוד</a><a class="button outline" href="#contact">דברו איתנו</a></div></div></section>
      <section class="section white"><div class="shell"><div class="section-heading"><span class="badge">What Breaks</span><h2>מה נשבר באפליקציות שנבנו ב-AI</h2><p>הדמו עובד — וזו בדיוק המלכודת. הכשלים צצים במקומות שדמו לעולם לא בודק: הרשאות, גישה לנתונים, תשלומים והמסלולים שלא הולכים חלק.</p></div><div class="stat-callout"><b>45% מהקוד שנוצר ב-AI מכיל פרצת אבטחה</b><small>Veracode, 2025</small></div><div class="cards three">{failures.map(([name, copy]) => <article class="failure card"><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>
      <section class="section"><div class="shell"><div class="section-heading"><span class="badge">Two Ways In</span><h2>שתי דרכים להתחיל</h2><p>מתחילים תמיד מבדיקה, לא מכתיבה מחדש. אחרי הבדיקה יודעים בדיוק מה צריך לתקן — ומה אפשר להשאיר.</p></div><div class="cards">{rescueOptions.map(([name, label, copy, tags]) => <article class="service-card card"><span class="icon-tile"><Icon name="check" /></span><h3>{name}</h3><strong>{label}</strong><p>{copy}</p><div class="chips">{(tags as string[]).map(tag => <span>{tag}</span>)}</div></article>)}</div></div></section>
      <section class="section dark"><div class="shell"><div class="section-heading"><span class="badge">The Rescue</span><h2>איך מתבצע חילוץ</h2><p>שישה שלבים, בסדר הזה. תיקוני האבטחה הקריטיים עולים ראשונים.</p></div><div class="steps">{rescueSteps.map(([num, name, copy]) => <article><b>{num}</b><h3>{name}</h3><p>{copy}</p></article>)}</div></div></section>
      <section class="section white"><div class="shell rescue-grid"><div><span class="badge">Production Ready</span><h2>מה כולל החילוץ</h2><p>רשימת המוכנות לייצור שאנחנו עוברים עליה בכל פרויקט.</p><ul>{checklist.map(item => <li><span class="check-icon"><Icon name="check" /></span><span>{item}</span></li>)}</ul></div><aside class="card"><h3>החלטה כנה: לשמר או לבנות מחדש</h3><p>אנחנו לא כותבים מחדש סתם. אם הקוד תקין מבחינה מבנית — מחזקים אותו וממשיכים הלאה.</p><h3>מסירה, לא נעילה</h3><p>כל חילוץ מסתיים בתיעוד, בדיקות והדרכה, כדי שהצוות שלכם יוכל להפעיל ולהרחיב בעצמו.</p></aside></div></section>
      <section class="section"><div class="shell"><div class="section-heading"><span class="badge">Tool Agnostic</span><h2>כלים שאנחנו מחלצים מהם</h2></div><div class="tool-cloud">{tools.map(tool => <span>{tool}</span>)}</div></div></section>
    </>
  )}
</BaseLayout>

<style>
  .centered{display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px}.service-hero{padding-block:96px}.service-hero h1{max-width:900px;font-size:44px;line-height:1.2}.service-hero p{max-width:780px;color:var(--muted);font-size:18px}.partner-lockup{display:flex;align-items:center;gap:20px}.partner-lockup img:first-child{width:99px}.partner-lockup img:last-child{width:197px}.partner-lockup span{font-size:28px;color:var(--muted)}.gold-badge{width:195px}.video-section,.dark{background:var(--dark);color:#efebe4}.light-text h2{max-width:820px;font-size:32px}.light-text>p{max-width:760px;color:#d2cbc2;font-size:18px}.video{position:relative;display:block;width:min(900px,100%);aspect-ratio:16/9;border-radius:16px;overflow:hidden}.video img{width:100%;height:100%;object-fit:cover}.video .play-icon{position:absolute;inset:50% auto auto 50%;translate:-50% -50%;display:grid;place-items:center;width:88px;height:88px;border-radius:50%;background:var(--primary);color:#1c2609;font-size:30px}.white{background:white}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.cards.three{grid-template-columns:repeat(3,1fr)}.chips{display:flex;flex-wrap:wrap;gap:8px}.chips span,.tool-cloud span{padding:4px 12px;border:1px solid var(--border);border-radius:999px;background:var(--paper);color:var(--muted);font-size:14px}.failure{padding:28px}.failure p{color:var(--muted)}.stat-callout{display:flex;flex-direction:column;align-items:center;gap:6px;width:max-content;max-width:100%;margin:0 auto 40px;padding:28px 40px;border-radius:16px;background:var(--primary-soft);text-align:center}.stat-callout b{font-size:28px}.stat-callout small{color:var(--muted)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.steps article{padding:28px;border:1px solid #efebe433;border-radius:16px}.steps b{color:var(--primary);font-size:28px}.steps p,.dark .section-heading p{color:#d2cbc2}.rescue-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center}.rescue-grid>div{display:flex;flex-direction:column;align-items:flex-start;gap:16px}.rescue-grid>div>p,.rescue-grid aside p{color:var(--muted)}.rescue-grid ul{display:grid;gap:12px;margin:8px 0 0;padding:0;list-style:none}.rescue-grid li{display:flex;align-items:flex-start;gap:10px}.rescue-grid .check-icon{display:inline-grid;place-items:center;width:24px;height:24px;flex:0 0 24px;border-radius:50%;background:var(--primary-soft);color:#527b18;font-size:16px}.rescue-grid aside{padding:32px;display:grid;gap:12px}.rescue-grid aside h3+ p{margin-bottom:16px}.tool-cloud{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:760px;margin:auto}.tool-cloud span{padding:8px 18px;background:white}.service-card .icon-tile{font-size:24px}.service-card strong{color:#1c2609}.stats{margin-inline:auto}
  @media(max-width:900px){.service-hero{padding-block:64px}.service-hero h1{font-size:38px}.cards,.cards.three,.steps,.rescue-grid{grid-template-columns:1fr}.steps{gap:16px}.rescue-grid{gap:32px}.video span{width:64px;height:64px}.partner-lockup img:last-child{width:161px}.section-heading{margin-bottom:40px}}
  @media(max-width:520px){.service-hero h1{font-size:34px}.service-hero .actions{width:100%}.service-hero .button{width:100%}.partner-lockup{gap:12px}.partner-lockup img:first-child{width:82px}.partner-lockup img:last-child{width:150px}.stat-callout{padding:24px}.stat-callout b{font-size:23px}.service-card,.failure,.steps article{padding:24px}.video-section{padding-block:64px}.light-text h2{font-size:28px}}
</style>
