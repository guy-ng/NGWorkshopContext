      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RejectEntry_di" bpmnElement="Gateway_RejectEntry" isMarkerVisible="true">
        <dc:Bounds x="1240" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1224" y="565" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRejection_di" bpmnElement="Task_NotifyRejection">
        <dc:Bounds x="1340" y="580" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OrderNotReleased_di" bpmnElement="End_OrderNotReleased">
        <dc:Bounds x="1500" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1480" y="645" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToHold_di" bpmnElement="Flow_StartToHold">
        <di:waypoint x="188" y="240" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HoldToExposure_di" bpmnElement="Flow_HoldToExposure">
        <di:waypoint x="340" y="240" />
        <di:waypoint x="400" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ExposureToRules_di" bpmnElement="Flow_ExposureToRules">
        <di:waypoint x="500" y="240" />
        <di:waypoint x="560" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RulesToRoute_di" bpmnElement="Flow_RulesToRoute">
        <di:waypoint x="660" y="240" />
