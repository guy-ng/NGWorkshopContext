        <di:waypoint x="1265" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReleaseEntryToRelease_di" bpmnElement="Flow_ReleaseEntryToRelease">
        <di:waypoint x="1290" y="120" />
        <di:waypoint x="1340" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReleasedEnd_di" bpmnElement="Flow_ToReleasedEnd">
        <di:waypoint x="1440" y="120" />
        <di:waypoint x="1500" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectEntryToNotify_di" bpmnElement="Flow_RejectEntryToNotify">
        <di:waypoint x="1290" y="620" />
        <di:waypoint x="1340" y="620" />
