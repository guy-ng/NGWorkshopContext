---
import type { Locale } from '../lib/i18n';
interface Props { locale?: Locale }
const { locale = 'he' } = Astro.props;
const t = {
  he: {
    title: 'AI בתוך התהליך, אדם בצומת הקריטי',
    description: 'הבקשה נבדקת בידי סוכן AI. מקרה בסיכון גבוה עובר לאישור אנושי, ומקרה בסיכון נמוך ממשיך אוטומטית.',
    request: 'בקשה', agent: 'סוכן AI', agentCopy: 'מנתח וממליץ', gate1: 'רמת', gate2: 'סיכון',
    low: 'נמוכה', high: 'גבוהה', done: 'הושלם', auto: 'ביצוע אוטומטי', human: 'אדם', humanCopy: 'בודק ומאשר',
  },
  en: {
    title: 'AI inside the process, a person at the critical junction',
    description: 'A request is assessed by an AI agent. High-risk cases go to human approval; low-risk cases continue automatically.',
    request: 'Request', agent: 'AI agent', agentCopy: 'Analyzes & recommends', gate1: 'Risk', gate2: 'level',
    low: 'Low', high: 'High', done: 'Completed', auto: 'Automatic execution', human: 'Person', humanCopy: 'Reviews & approves',
  },
}[locale];
---
<figure class="hitl-flow" dir={locale === 'he' ? 'rtl' : 'ltr'} aria-labelledby="hitl-flow-title hitl-flow-description">
  <figcaption>
    <strong id="hitl-flow-title">{t.title}</strong>
    <span id="hitl-flow-description">{t.description}</span>
  </figcaption>

  <div class="flow-frame">
    <svg viewBox="0 0 960 420" aria-hidden="true" focusable="false">
      <defs>
        <marker id="hitl-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#8a9a96" />
        </marker>
        <filter id="hitl-shadow" x="-20%" y="-30%" width="140%" height="160%">
          <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#102a24" flood-opacity=".12" />
        </filter>
      </defs>

      <g class="connections" fill="none" stroke="#8a9a96" stroke-width="3" marker-end="url(#hitl-arrow)">
        <path d="M98 210H206" />
        <path d="M414 210H476" />
        <path d="M614 210H655V95H696" />
        <path d="M614 210H655V325H696" />
      </g>

      <g class="start-node">
        <circle cx="70" cy="210" r="28" fill="#fff" stroke="#176650" stroke-width="4" />
        <text x="70" y="268" text-anchor="middle" class="node-caption">{t.request}</text>
      </g>

      <g class="ai-node" filter="url(#hitl-shadow)">
        <rect x="210" y="150" width="200" height="120" rx="20" fill="#eff8e3" stroke="#79a82f" stroke-width="4" />
        <circle class="ai-glow" cx="250" cy="210" r="16" fill="none" stroke="#8abf3b" stroke-width="4" />
        <circle cx="250" cy="210" r="16" fill="#8abf3b" />
        <path d="M242 210h16M250 202v16" stroke="#243114" stroke-width="3" stroke-linecap="round" />
        <text x="340" y="204" text-anchor="middle" class="node-title">{t.agent}</text>
        <text x="340" y="230" text-anchor="middle" class="node-copy">{t.agentCopy}</text>
      </g>

      <g class="gateway">
        <path d="M545 148L610 210L545 272L480 210Z" fill="#fff" stroke="#176650" stroke-width="4" />
        <text x="545" y="204" text-anchor="middle" class="gateway-title">{t.gate1}</text>
        <text x="545" y="227" text-anchor="middle" class="gateway-title">{t.gate2}</text>
        <text x="648" y="86" text-anchor="end" class="route-label">{t.low}</text>
        <text x="648" y="352" text-anchor="end" class="route-label">{t.high}</text>
      </g>

      <g class="auto-node" filter="url(#hitl-shadow)">
        <rect x="700" y="45" width="210" height="100" rx="18" fill="#eff8e3" stroke="#79a82f" stroke-width="4" />
        <path d="M727 96l11 12 25-27" fill="none" stroke="#527b18" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        <text x="840" y="103" text-anchor="middle" class="node-title">{t.done}</text>
        <text x="805" y="176" text-anchor="middle" class="node-caption">{t.auto}</text>
      </g>

      <g class="human-node" filter="url(#hitl-shadow)">
        <rect class="human-pulse" x="692" y="267" width="226" height="116" rx="22" fill="none" stroke="#8abf3b" stroke-width="4" />
        <rect x="700" y="275" width="210" height="100" rx="18" fill="#fff" stroke="#176650" stroke-width="4" />
        <circle cx="741" cy="308" r="13" fill="#176650" />
        <path d="M719 348c3-16 12-24 22-24s19 8 22 24" fill="#176650" />
        <text x="840" y="318" text-anchor="middle" class="node-title">{t.human}</text>
        <text x="840" y="342" text-anchor="middle" class="node-copy">{t.humanCopy}</text>
      </g>

      <circle class="token token-in" r="9" fill="#8abf3b" />
      <circle class="token token-out" r="9" fill="#8abf3b" />
      <circle class="token token-low" r="9" fill="#8abf3b" />
      <circle class="token token-high" r="9" fill="#176650" />
    </svg>
  </div>
</figure>

<style>
  .hitl-flow { max-width: 1000px; margin: 3rem auto; }
  figcaption { display: grid; gap: .35rem; margin-bottom: 1rem; text-align: center; }
  figcaption strong { color: #102a24; font-size: clamp(1.25rem, 3vw, 1.7rem); }
  figcaption span { max-width: 720px; margin-inline: auto; color: #60716d; line-height: 1.7; }
  .flow-frame { overflow: hidden; border: 1px solid #d9e2de; border-radius: 24px; background: linear-gradient(145deg, #fff, #f5f9f7); box-shadow: 0 20px 55px #102a2414; }
  svg { display: block; width: 100%; height: auto; direction: ltr; }
  text { font-family: "Heebo", system-ui, sans-serif; fill: #253833; }
  .node-title { font-size: 22px; font-weight: 800; }
  .node-copy { font-size: 16px; fill: #60716d; }
  .gateway-title { font-size: 18px; font-weight: 800; }
  .route-label { font-size: 16px; font-weight: 700; fill: #527b18; }
  .node-caption { font-size: 15px; fill: #60716d; }

  /* One 6s cycle: request -> AI thinks -> gateway -> both routes -> human review. */
  .token { opacity: 0; offset-rotate: 0deg; }
  .token-in { offset-path: path("M98 210H206"); animation: token-in 6s linear infinite; }
  .token-out { offset-path: path("M414 210H476"); animation: token-out 6s linear infinite; }
  .token-low { offset-path: path("M614 210H655V95H696"); animation: token-low 6s linear infinite; }
  .token-high { offset-path: path("M614 210H655V325H696"); animation: token-high 6s linear infinite; }
  .ai-glow { transform-box: fill-box; transform-origin: center; opacity: 0; animation: ai-glow 6s ease-out infinite; }
  .human-pulse { transform-box: fill-box; transform-origin: center; opacity: 0; animation: human-pulse 6s ease-out infinite; }

  @keyframes token-in {
    0% { opacity: 0; offset-distance: 0%; }
    3% { opacity: 1; }
    18% { opacity: 1; offset-distance: 100%; }
    22%, 100% { opacity: 0; offset-distance: 100%; }
  }
  @keyframes token-out {
    0%, 30% { opacity: 0; offset-distance: 0%; }
    33% { opacity: 1; }
    45% { opacity: 1; offset-distance: 100%; }
    49%, 100% { opacity: 0; offset-distance: 100%; }
  }
  @keyframes token-low {
    0%, 52% { opacity: 0; offset-distance: 0%; }
    55% { opacity: 1; }
    72% { opacity: 1; offset-distance: 100%; }
    76%, 100% { opacity: 0; offset-distance: 100%; }
  }
  @keyframes token-high {
    0%, 56% { opacity: 0; offset-distance: 0%; }
    59% { opacity: 1; }
    77% { opacity: 1; offset-distance: 100%; }
    81%, 100% { opacity: 0; offset-distance: 100%; }
  }
  @keyframes ai-glow {
    0%, 19% { opacity: 0; transform: scale(1); }
    24% { opacity: .6; }
    32%, 100% { opacity: 0; transform: scale(2); }
  }
  @keyframes human-pulse {
    0%, 79% { opacity: 0; transform: scale(.96); }
    85% { opacity: .75; }
    95%, 100% { opacity: 0; transform: scale(1.06); }
  }

  @media (max-width: 620px) { .flow-frame { border-radius: 16px; } figcaption span { font-size: .95rem; } }
  @media (prefers-reduced-motion: reduce) {
    .token, .ai-glow, .human-pulse { animation: none; }
    .token-out { opacity: 1; offset-distance: 50%; }
  }
</style>
