---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import HumanInLoopFlow from '../../../components/HumanInLoopFlow.astro';
import Icon from '../../../components/Icon.astro';
import { safeJson } from '../../../lib/safe-json';

export async function getStaticPaths() {
  const includeDrafts = !import.meta.env.PROD || import.meta.env.INCLUDE_DRAFTS === 'true';
  const posts = await getCollection('blog', ({ data }) => !data.draft || includeDrafts);
  return posts.filter(({ data }) => data.locale === 'he').map((post) => ({ params: { slug: post.data.urlSlug }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };

const { Content } = await render(post);
const includeDrafts = !import.meta.env.PROD || import.meta.env.INCLUDE_DRAFTS === 'true';
const allHebrew = await getCollection('blog', ({ data }) => data.locale === 'he' && (!data.draft || includeDrafts));
const allPosts = await getCollection('blog', ({ data }) => !data.draft || includeDrafts);
const translation = allPosts.find(({ data }) => data.locale === 'en' && data.translationKey === post.data.translationKey);
const translatedPath = translation ? `/en/blog/${translation.data.urlSlug}/` : null;
const related = allHebrew
  .filter((entry) => entry.id !== post.id && (entry.data.category === post.data.category || entry.data.tags.some((tag) => post.data.tags.includes(tag))))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const formatDate = (date: Date) => new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const authorName = post.data.author === 'Guy Elisha' ? 'גיא אלישע' : post.data.author;
const canonicalUrl = new URL(`/he/blog/${post.data.urlSlug}/`, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.seoDescription ?? post.data.excerpt,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'NG Workshop', url: new URL('/', Astro.site).href },
  mainEntityOfPage: canonicalUrl.href,
  inLanguage: 'he',
  ...(post.data.coverImage ? { image: new URL(post.data.coverImage, Astro.site).href } : {}),
};
---
<BaseLayout
  locale="he"
  title={post.data.seoTitle ?? `${post.data.title} | NG Workshop`}
  description={post.data.seoDescription ?? post.data.excerpt}
  image={post.data.coverImage}
  alternatePath={translatedPath}
  languagePath={translatedPath ?? '/en/blog/'}
  contactMessage={`היי! קראתם עכשיו על "${post.data.title}". רוצים לבחון איך הרעיונות במאמר מתחברים לתהליך אצלכם? ספרו לי מה תרצו לקדם.`}
>
  <script is:inline type="application/ld+json" set:html={safeJson(jsonLd)} />
  <article class="article-shell">
    <header class="article-header shell">
      <a class="back-link" href="/he/blog/"><Icon name="arrow-left" /><span class="back-label">חזרה לבלוג</span></a>
      <span class="badge">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.excerpt}</p>
      <div class="byline">
        <span>{authorName}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      </div>
    </header>
    {post.data.coverImage && <div class="cover shell"><img src={post.data.coverImage} alt={post.data.coverAlt ?? ''} width="1200" height="675" /></div>}
    {post.data.urlSlug === 'human-in-the-loop-governance' && <HumanInLoopFlow locale="he" />}
    {post.data.youtubeUrl && <YouTubeEmbed url={post.data.youtubeUrl} title={post.data.youtubeTitle ?? `סרטון: ${post.data.title}`} />}
    <div class="prose shell"><Content /></div>
    {post.data.tags.length > 0 && <footer class="tag-list shell" aria-label="תגיות">{post.data.tags.map((tag) => <span>{tag}</span>)}</footer>}
  </article>

  {related.length > 0 && (
    <section class="related section">
      <div class="shell">
        <h2>אולי יעניין אתכם גם</h2>
        <div class="related-grid">{related.map((entry) => <a class="related-link" href={`/he/blog/${entry.data.urlSlug}/`}><article class="card"><span>{entry.data.category}</span><h3>{entry.data.title}</h3><p>{entry.data.excerpt}</p></article></a>)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-shell { padding-block: clamp(4.5rem, 9vw, 8rem) 5rem; }
  .article-header { max-width: 900px; text-align: center; }
  .back-link { display: flex; width: max-content; margin: 0 0 2rem auto; align-items: center; gap: .45rem; direction: ltr; color: #4e655f; }
  .back-link span { unicode-bidi: isolate; }
  .back-label { direction: rtl; }
  .article-header h1 { max-width: 850px; margin: 1rem auto; font-size: clamp(2.4rem, 6vw, 4.8rem); line-height: 1.05; }
  .lead { max-width: 730px; margin: 1.25rem auto; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.7; }
  .byline { display: flex; justify-content: center; gap: .6rem; color: #60716d; font-size: .95rem; }
  .cover { max-width: 1100px; margin-block: 3rem; }
  .cover img { width: 100%; max-height: 600px; object-fit: cover; border-radius: 24px; }
  .prose { max-width: 760px; color: #253833; font-size: 1.1rem; line-height: 1.9; }
  .prose :global(h2) { margin-block: 2.5rem .8rem; color: #102a24; font-size: 1.8rem; }
  .prose :global(p), .prose :global(ol), .prose :global(ul) { margin-block: 1rem; }
  .prose :global(a) { color: #116953; }
  .tag-list { max-width: 760px; display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.5rem; }
  .tag-list span { padding: .45rem .8rem; border-radius: 99px; background: #eaf5f1; color: #176650; font-size: .84rem; }
  .related { padding-block: 5rem; background: #f4f8f6; }
  .related h2 { margin-bottom: 1.5rem; }
  .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .related-link { display: block; color: inherit; text-decoration: none; border-radius: 16px; }
  .related-grid article { height: 100%; padding: 1.75rem; }
  .related-grid span { color: #19735f; font-size: .84rem; font-weight: 700; }
  .related-grid h3 { margin-block: .65rem; font-size: 1.35rem; }
  @media (max-width: 700px) { .related-grid { grid-template-columns: 1fr; } .cover img { border-radius: 14px; } }
</style>
