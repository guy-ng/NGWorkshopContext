  "cards": [
    {
      "dot": "cyan",
      "title": "Decision ownership",
      "items": [
        "The agent may propose, ask questions, and explain; it never authorizes",
        "Only structured inputs and versioned deterministic rules produce a decision",
        "Free-text model output is never accepted as an approval artifact"
      ]
    },
    {
      "dot": "rose",
      "title": "Defense in depth",
      "items": [
        "Protocol approval checks conditions, medications, cumulative dose, and timing",
        "Order creation verifies the unchanged approval and signs the cartridge manifest",
        "Per-pill and cartridge gatekeepers must independently ALLOW physical release"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fail closed & traceable",
      "items": [
        "Missing, stale, conflicting, unknown, or unavailable evidence blocks action",
        "Single-use authorization and idempotency prevent duplicate dispensing",
        "Every decision records inputs, versions, reason codes, timestamps, and outcomes"
      ]
    }
  ]
