        <di:waypoint x="340" y="240" />
        <di:waypoint x="400" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RulesToRoute_di" bpmnElement="Flow_RulesToRoute">
        <di:waypoint x="500" y="240" />
        <di:waypoint x="560" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RouteAutoCredit_di" bpmnElement="Flow_RouteAutoCredit">
        <di:waypoint x="585" y="215" />
        <di:waypoint x="585" y="120" />
        <di:waypoint x="960" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="96" width="130" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RouteWarehouse_di" bpmnElement="Flow_RouteWarehouse">
