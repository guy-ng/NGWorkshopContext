<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:ns1="modeler" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:ns0="xmlns" id="bpmn_copilot_Definition_id" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="80a5306" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0" ns0:modeler="http://camunda.org/schema/modeler/1.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.6">
  <bpmn:process id="Process_PizzaCamundencia" name="תהליך הכנת פיצה" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="הזמנה התקבלה">
      <bpmn:outgoing>Flow_To_ValidateOrder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ValidateOrder" name="אימות הזמנה">
      <bpmn:incoming>Flow_To_ValidateOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OrderValidGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_To_ValidateOrder" sourceRef="StartEvent_OrderReceived" targetRef="Task_ValidateOrder" />
    <bpmn:exclusiveGateway id="Gateway_IsOrderValid" name="האם ההזמנה תקינה?">
      <bpmn:incoming>Flow_To_OrderValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderIsValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderIsInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_To_OrderValidGateway" sourceRef="Task_ValidateOrder" targetRef="Gateway_IsOrderValid" />
    <bpmn:task id="Task_NotifyCustomer" name="הודעה ללקוח על ביטול">
      <bpmn:incoming>Flow_OrderIsInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OrderCanceled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_OrderIsInvalid" name="לא" sourceRef="Gateway_IsOrderValid" targetRef="Task_NotifyCustomer" />
    <bpmn:endEvent id="EndEvent_OrderCanceled" name="הזמנה בוטלה">
      <bpmn:incoming>Flow_To_OrderCanceled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_OrderCanceled" sourceRef="Task_NotifyCustomer" targetRef="EndEvent_OrderCanceled" />
    <bpmn:parallelGateway id="Gateway_StartPreparation">
      <bpmn:incoming>Flow_OrderIsValid</bpmn:incoming>
      <bpmn:outgoing>Flow_To_PrepareDough</bpmn:outgoing>
      <bpmn:outgoing>Flow_1pc39cf</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_OrderIsValid" name="כן" sourceRef="Gateway_IsOrderValid" targetRef="Gateway_StartPreparation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task_PrepareDough" name="הכנת בצק">
      <bpmn:incoming>Flow_To_PrepareDough</bpmn:incoming>
      <bpmn:outgoing>Flow_From_PrepareDough</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_To_PrepareDough" sourceRef="Gateway_StartPreparation" targetRef="Task_PrepareDough" />
    <bpmn:task id="Task_PrepareSauce" name="הכנת רוטב">
      <bpmn:incoming>Flow_1pc39cf</bpmn:incoming>
      <bpmn:outgoing>Flow_From_PrepareSauce</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_JoinPreparation">
      <bpmn:incoming>Flow_From_PrepareDough</bpmn:incoming>
      <bpmn:incoming>Flow_From_PrepareSauce</bpmn:incoming>
      <bpmn:outgoing>Flow_To_AddToppings</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_From_PrepareDough" sourceRef="Task_PrepareDough" targetRef="Gateway_JoinPreparation" />
    <bpmn:sequenceFlow id="Flow_From_PrepareSauce" sourceRef="Task_PrepareSauce" targetRef="Gateway_JoinPreparation" />
    <bpmn:task id="Task_AddToppingsAndBake" name="הוספת תוספות ואפייה">
      <bpmn:incoming>Flow_To_AddToppings</bpmn:incoming>
      <bpmn:outgoing>Flow_To_QualityControl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_To_AddToppings" sourceRef="Gateway_JoinPreparation" targetRef="Task_AddToppingsAndBake" />
    <bpmn:task id="Task_QualityControl" name="בקרת איכות">
      <bpmn:incoming>Flow_To_QualityControl</bpmn:incoming>
      <bpmn:outgoing>Flow_To_QCGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_To_QualityControl" sourceRef="Task_AddToppingsAndBake" targetRef="Task_QualityControl" />
    <bpmn:exclusiveGateway id="Gateway_QCPassed" name="האם הפיצה עברה בקרת איכות?">
      <bpmn:incoming>Flow_To_QCGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_QCPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_QCFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_To_QCGateway" sourceRef="Task_QualityControl" targetRef="Gateway_QCPassed" />
    <bpmn:task id="Task_SendRefund" name="שליחת החזר כספי">
      <bpmn:incoming>Flow_QCFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OrderFailed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_QCFailed" name="לא" sourceRef="Gateway_QCPassed" targetRef="Task_SendRefund" />
    <bpmn:endEvent id="EndEvent_OrderFailed" name="הזמנה נכשלה">
      <bpmn:incoming>Flow_To_OrderFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_OrderFailed" sourceRef="Task_SendRefund" targetRef="EndEvent_OrderFailed" />
    <bpmn:task id="Task_PackAndSend" name="אריזה ושליחה ללקוח">
      <bpmn:incoming>Flow_QCPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OrderSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_QCPassed" name="כן" sourceRef="Gateway_QCPassed" targetRef="Task_PackAndSend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qcPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_OrderSent" name="הזמנה נשלחה">
      <bpmn:incoming>Flow_To_OrderSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_OrderSent" sourceRef="Task_PackAndSend" targetRef="EndEvent_OrderSent" />
    <bpmn:sequenceFlow id="Flow_1pc39cf" sourceRef="Gateway_StartPreparation" targetRef="Task_PrepareSauce" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_PizzaCamundencia">
