<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CollectionsLadder" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="CollectionsLadder" name="סולם הגבייה" isExecutable="true">
    <bpmn:startEvent id="Start_InvoiceIssued" name="חשבונית הופקה ונשלחה ללקוח">
      <bpmn:outgoing>Flow_StartToLoop</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_InvoiceIssued" messageRef="Message_InvoiceIssued" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_LoopEntry" name="הערכה מחדש">
      <bpmn:incoming>Flow_StartToLoop</bpmn:incoming>
      <bpmn:incoming>Flow_TimerLoop</bpmn:incoming>
      <bpmn:incoming>Flow_PartialPaymentLoop</bpmn:incoming>
      <bpmn:incoming>Flow_DisputeBalanceLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopToAssess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_AssessOverdue" name="חישוב ימי פיגור ויתרה פתוחה">
      <bpmn:extensionElements>
        <zeebe:script expression="={daysOverdue: (today() - date(dueDate)).days, openAmount: invoiceAmount - settledSoFar, step: previousStep + 1}" resultVariable="overdue" />
        <zeebe:ioMapping>
          <zeebe:input source="=if is defined(settledAmount) then settledAmount else 0" target="settledSoFar" />
          <zeebe:input source="=if is defined(overdue) then overdue.step else 0" target="previousStep" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LoopToAssess</bpmn:incoming>
      <bpmn:outgoing>Flow_AssessToRules</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Rules_CollectionLadder" name="טבלת מדרג הגבייה (בשליטת סמנכ&quot;ל כספים)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="collection_ladder" resultVariable="ladder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AssessToRules</bpmn:incoming>
      <bpmn:outgoing>Flow_RulesToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_CollectionAction" name="איזו פעולה?" default="Flow_ActionLegal">
      <bpmn:incoming>Flow_RulesToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ActionReminder</bpmn:outgoing>
      <bpmn:outgoing>Flow_ActionCall</bpmn:outgoing>
      <bpmn:outgoing>Flow_ActionNone</bpmn:outgoing>
      <bpmn:outgoing>Flow_ActionCreditHold</bpmn:outgoing>
      <bpmn:outgoing>Flow_ActionLegal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SendPaymentReminder" name="שליחת תזכורת ללקוח">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-payment-reminder" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=ladder.action" target="reminderTone" />
          <zeebe:input source="=overdue.openAmount" target="openAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ActionReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_LogCollectionCall" name="שיחת גבייה מתועדת">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="collection-call" />
        <zeebe:assignmentDefinition candidateGroups="collections" />
        <zeebe:taskSchedule dueDate="=string(now() + duration(&quot;P2D&quot;))" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ActionCall</bpmn:incoming>
      <bpmn:outgoing>Flow_CallDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ApplyCreditHold" name="עצירת אשראי ללקוח בפריוריטי">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-credit-hold" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="creditHoldActive" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ActionCreditHold</bpmn:incoming>
      <bpmn:outgoing>Flow_HoldToNotify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyManufacturerRisk" name="דיווח סיכון אשראי ליצרן">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-manufacturer-credit-risk" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=overdue.daysOverdue" target="daysOverdue" />
          <zeebe:input source="=overdue.openAmount" target="openAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HoldToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_HoldDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ApproveLegalHandover" name="אישור העברה לטיפול משפטי">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="legal-handover-approval" />
        <zeebe:assignmentDefinition candidateGroups="finance_managers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ActionLegal</bpmn:incoming>
      <bpmn:outgoing>Flow_LegalApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_OpenLegalCase" name="פתיחת תיק גבייה משפטי ודיווח ליצרן">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="open-legal-collection-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LegalApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLegalEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_TransferredToLegal" name="הועבר לטיפול משפטי">
      <bpmn:incoming>Flow_ToLegalEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ActionCompleted" name="הפעולה בוצעה">
      <bpmn:incoming>Flow_ReminderDone</bpmn:incoming>
      <bpmn:incoming>Flow_CallDone</bpmn:incoming>
      <bpmn:incoming>Flow_ActionNone</bpmn:incoming>
      <bpmn:incoming>Flow_HoldDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_AwaitNextEvent" name="מה יקרה קודם?">
      <bpmn:incoming>Flow_ToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToTimerEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToDisputeEvent</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="התקבל תקבול">
      <bpmn:incoming>Flow_ToPaymentEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentToApply</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_PaymentReceived" messageRef="Message_PaymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_LadderTimer" name="חלף פרק הזמן שנקבע במדרג">
      <bpmn:incoming>Flow_ToTimerEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerLoop</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Ladder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=duration(ladder.waitDuration)</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_DisputeRaised" name="הלקוח פתח מחלוקת">
      <bpmn:incoming>Flow_ToDisputeEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_DisputeToCall</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_DisputeRaised" messageRef="Message_DisputeRaised" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ApplyPayment" name="התאמת התקבול לחשבונית">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-cash-receipt" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="=payment.totalSettledAmount" target="settledAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentToApply</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyToCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentSettled" name="החשבונית נסגרה?" default="Flow_PartialPaymentLoop">
      <bpmn:incoming>Flow_ApplyToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_FullySettled</bpmn:outgoing>
      <bpmn:outgoing>Flow_PartialPaymentLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_DebtClosed" name="החוב נסגר">
      <bpmn:incoming>Flow_FullySettled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_InvoiceDispute" name="בירור מחלוקת על חשבונית">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="InvoiceDispute" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=invoiceId" target="invoiceId" />
          <zeebe:input source="=customerId" target="customerId" />
          <zeebe:input source="=customerSegment" target="customerSegment" />
          <zeebe:input source="=invoiceAmount" target="invoiceAmount" />
          <zeebe:output source="=dispute.totalSettledAmount" target="settledAmount" />
          <zeebe:output source="=dispute.outcome" target="disputeOutcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DisputeToCall</bpmn:incoming>
      <bpmn:outgoing>Flow_DisputeToOutcome</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_DisputeOutcome" name="זוכתה במלואה?" default="Flow_DisputeBalanceLoop">
      <bpmn:incoming>Flow_DisputeToOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_FullyCredited</bpmn:outgoing>
      <bpmn:outgoing>Flow_DisputeBalanceLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_InvoiceCredited" name="החשבונית זוכתה במלואה">
      <bpmn:incoming>Flow_FullyCredited</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToLoop" sourceRef="Start_InvoiceIssued" targetRef="Gateway_LoopEntry" />
    <bpmn:sequenceFlow id="Flow_LoopToAssess" sourceRef="Gateway_LoopEntry" targetRef="Script_AssessOverdue" />
    <bpmn:sequenceFlow id="Flow_AssessToRules" sourceRef="Script_AssessOverdue" targetRef="Rules_CollectionLadder" />
    <bpmn:sequenceFlow id="Flow_RulesToGateway" sourceRef="Rules_CollectionLadder" targetRef="Gateway_CollectionAction" />
    <bpmn:sequenceFlow id="Flow_ActionReminder" name="תזכורת" sourceRef="Gateway_CollectionAction" targetRef="Task_SendPaymentReminder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ladder.action in ("PRE_REMINDER", "REMINDER")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ActionCall" name="שיחת גבייה" sourceRef="Gateway_CollectionAction" targetRef="Task_LogCollectionCall">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ladder.action = "CALL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ActionNone" name="אין פעולה — המתנה" sourceRef="Gateway_CollectionAction" targetRef="Gateway_ActionCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ladder.action = "NONE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ActionCreditHold" name="עצירת אשראי" sourceRef="Gateway_CollectionAction" targetRef="Task_ApplyCreditHold">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ladder.action = "CREDIT_HOLD"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ActionLegal" name="משפטי" sourceRef="Gateway_CollectionAction" targetRef="Task_ApproveLegalHandover" />
    <bpmn:sequenceFlow id="Flow_ReminderDone" sourceRef="Task_SendPaymentReminder" targetRef="Gateway_ActionCompleted" />
    <bpmn:sequenceFlow id="Flow_CallDone" sourceRef="Task_LogCollectionCall" targetRef="Gateway_ActionCompleted" />
    <bpmn:sequenceFlow id="Flow_HoldToNotify" sourceRef="Task_ApplyCreditHold" targetRef="Task_NotifyManufacturerRisk" />
    <bpmn:sequenceFlow id="Flow_HoldDone" sourceRef="Task_NotifyManufacturerRisk" targetRef="Gateway_ActionCompleted" />
    <bpmn:sequenceFlow id="Flow_LegalApproved" sourceRef="Task_ApproveLegalHandover" targetRef="Task_OpenLegalCase" />
    <bpmn:sequenceFlow id="Flow_ToLegalEnd" sourceRef="Task_OpenLegalCase" targetRef="End_TransferredToLegal" />
    <bpmn:sequenceFlow id="Flow_ToWait" sourceRef="Gateway_ActionCompleted" targetRef="Gateway_AwaitNextEvent" />
    <bpmn:sequenceFlow id="Flow_ToPaymentEvent" sourceRef="Gateway_AwaitNextEvent" targetRef="Event_PaymentReceived" />
    <bpmn:sequenceFlow id="Flow_ToTimerEvent" sourceRef="Gateway_AwaitNextEvent" targetRef="Event_LadderTimer" />
    <bpmn:sequenceFlow id="Flow_ToDisputeEvent" sourceRef="Gateway_AwaitNextEvent" targetRef="Event_DisputeRaised" />
    <bpmn:sequenceFlow id="Flow_PaymentToApply" sourceRef="Event_PaymentReceived" targetRef="Task_ApplyPayment" />
    <bpmn:sequenceFlow id="Flow_ApplyToCheck" sourceRef="Task_ApplyPayment" targetRef="Gateway_PaymentSettled" />
    <bpmn:sequenceFlow id="Flow_FullySettled" name="כן" sourceRef="Gateway_PaymentSettled" targetRef="End_DebtClosed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=payment.remainingAmount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PartialPaymentLoop" name="תשלום חלקי" sourceRef="Gateway_PaymentSettled" targetRef="Gateway_LoopEntry" />
    <bpmn:sequenceFlow id="Flow_TimerLoop" sourceRef="Event_LadderTimer" targetRef="Gateway_LoopEntry" />
    <bpmn:sequenceFlow id="Flow_DisputeToCall" sourceRef="Event_DisputeRaised" targetRef="Call_InvoiceDispute" />
    <bpmn:sequenceFlow id="Flow_DisputeToOutcome" sourceRef="Call_InvoiceDispute" targetRef="Gateway_DisputeOutcome" />
    <bpmn:sequenceFlow id="Flow_FullyCredited" name="כן" sourceRef="Gateway_DisputeOutcome" targetRef="End_InvoiceCredited">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=disputeOutcome = "FULL_CREDIT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DisputeBalanceLoop" name="נותרה יתרה" sourceRef="Gateway_DisputeOutcome" targetRef="Gateway_LoopEntry" />
  </bpmn:process>
  <bpmn:message id="Message_InvoiceIssued" name="invoice-issued" />
  <bpmn:message id="Message_PaymentReceived" name="payment-received">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=invoiceId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_DisputeRaised" name="invoice-disputed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=invoiceId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CollectionsLadder">
      <bpmndi:BPMNShape id="Start_InvoiceIssued_di" bpmnElement="Start_InvoiceIssued">
        <dc:Bounds x="152" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="132" y="365" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LoopEntry_di" bpmnElement="Gateway_LoopEntry" isMarkerVisible="true">
        <dc:Bounds x="245" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="285" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_AssessOverdue_di" bpmnElement="Script_AssessOverdue">
        <dc:Bounds x="350" y="300" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rules_CollectionLadder_di" bpmnElement="Rules_CollectionLadder">
        <dc:Bounds x="510" y="300" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CollectionAction_di" bpmnElement="Gateway_CollectionAction" isMarkerVisible="true">
        <dc:Bounds x="670" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="663" y="285" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendPaymentReminder_di" bpmnElement="Task_SendPaymentReminder">
        <dc:Bounds x="780" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogCollectionCall_di" bpmnElement="Task_LogCollectionCall">
        <dc:Bounds x="780" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApplyCreditHold_di" bpmnElement="Task_ApplyCreditHold">
        <dc:Bounds x="780" y="420" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyManufacturerRisk_di" bpmnElement="Task_NotifyManufacturerRisk">
        <dc:Bounds x="940" y="420" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveLegalHandover_di" bpmnElement="Task_ApproveLegalHandover">
        <dc:Bounds x="780" y="560" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenLegalCase_di" bpmnElement="Task_OpenLegalCase">
        <dc:Bounds x="940" y="560" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_TransferredToLegal_di" bpmnElement="End_TransferredToLegal">
        <dc:Bounds x="1100" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1080" y="625" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ActionCompleted_di" bpmnElement="Gateway_ActionCompleted" isMarkerVisible="true">
        <dc:Bounds x="1120" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1113" y="285" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AwaitNextEvent_di" bpmnElement="Gateway_AwaitNextEvent">
        <dc:Bounds x="1220" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="285" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PaymentReceived_di" bpmnElement="Event_PaymentReceived">
        <dc:Bounds x="1330" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1315" y="192" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_LadderTimer_di" bpmnElement="Event_LadderTimer">
        <dc:Bounds x="1330" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1310" y="365" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_DisputeRaised_di" bpmnElement="Event_DisputeRaised">
        <dc:Bounds x="1330" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1310" y="485" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApplyPayment_di" bpmnElement="Task_ApplyPayment">
        <dc:Bounds x="1430" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentSettled_di" bpmnElement="Gateway_PaymentSettled" isMarkerVisible="true">
        <dc:Bounds x="1590" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1578" y="185" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_DebtClosed_di" bpmnElement="End_DebtClosed">
        <dc:Bounds x="1700" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1690" y="265" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_InvoiceDispute_di" bpmnElement="Call_InvoiceDispute">
        <dc:Bounds x="1430" y="420" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DisputeOutcome_di" bpmnElement="Gateway_DisputeOutcome" isMarkerVisible="true">
        <dc:Bounds x="1590" y="435" width="50" height="50" />
