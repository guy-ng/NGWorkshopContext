#!/usr/bin/env bash
# Launcher for the nanobanana CLI.
# Resolves symlinks (so ~/.local/bin/nanobanana works), bootstraps the venv on
# first run, then hands off to the Python entrypoint.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")/.." && pwd)"

venv="$here/venv"
py="$venv/bin/python3"

if [ ! -x "$py" ]; then
  echo "nanobanana: first run — creating venv at $venv" >&2
  python3 -m venv "$venv" >&2
  "$venv/bin/pip" install --quiet --upgrade pip >&2
  "$venv/bin/pip" install --quiet -r "$here/requirements.txt" >&2
  echo "nanobanana: ready" >&2
fi

exec "$py" "$here/nanobanana.py" "$@"
