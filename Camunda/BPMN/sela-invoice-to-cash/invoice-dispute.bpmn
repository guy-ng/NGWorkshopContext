      <bpmndi:BPMNEdge id="Flow_StartToEvidence_di" bpmnElement="Flow_StartToEvidence">
        <di:waypoint x="188" y="240" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
