<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CreditExceptionApproval" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="CreditExceptionApproval" name="החלטת אשראי חריגה בזמן ההזמנה" isExecutable="true">
    <bpmn:startEvent id="Start_CreditBreach" name="הזמנה חורגת ממסגרת האשראי">
      <bpmn:outgoing>Flow_StartToHold</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CreditBreach" messageRef="Message_CreditLimitBreached" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_HoldOrder" name="החזקת ההזמנה ועדכון הסוכן והלקוח">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hold-order-in-erp" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderId" target="orderId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToHold</bpmn:incoming>
      <bpmn:outgoing>Flow_HoldToExposure</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuildExposureView" name="ריכוז תמונת חשיפה: חוב פתוח, הזמנות בליקוט ומלאי קונסיגנציה">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-customer-exposure" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=customerId" target="customerId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HoldToExposure</bpmn:incoming>
      <bpmn:outgoing>Flow_ExposureToRules</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Rules_CreditRouting" name="מי מאשר ותוך כמה זמן">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="credit_exception_routing" resultVariable="creditRoute" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ExposureToRules</bpmn:incoming>
      <bpmn:outgoing>Flow_RulesToRoute</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_CreditRoute" name="מסלול ההחלטה" default="Flow_RouteManual">
      <bpmn:incoming>Flow_RulesToRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteAutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteAutoReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteManual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CreditDecision" name="החלטת אשראי חריגה">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="credit-exception-decision" />
        <zeebe:assignmentDefinition candidateGroups="=[creditRoute.approverGroup]" />
        <zeebe:taskSchedule dueDate="=string(now() + duration(creditRoute.slaDuration))" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteManual</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionMade</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_CreditSla" name="חריגת SLA" attachedToRef="Task_CreditDecision" cancelActivity="false">
      <bpmn:outgoing>Flow_CreditSlaBreach</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_CreditSla">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=duration(creditRoute.slaDuration)</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_EscalateToCfo" name="הסלמה לסמנכ&quot;ל הכספים ועדכון הסוכן">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate-credit-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreditSlaBreach</bpmn:incoming>
      <bpmn:outgoing>Flow_CfoToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_SlaEscalated" name="ההסלמה נשלחה">
      <bpmn:incoming>Flow_CfoToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="מה הוחלט?" default="Flow_DecisionRejected">
      <bpmn:incoming>Flow_DecisionMade</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionPartial</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleasePartial" name="שחרור חלקי של ההזמנה בגובה המסגרת">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-order-partially" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=approvedOrderAmount" target="approvedOrderAmount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecisionPartial</bpmn:incoming>
      <bpmn:outgoing>Flow_PartialToRelease</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ReleaseEntry" name="שחרור ההזמנה">
      <bpmn:incoming>Flow_RouteAutoApprove</bpmn:incoming>
      <bpmn:incoming>Flow_DecisionApproved</bpmn:incoming>
      <bpmn:incoming>Flow_PartialToRelease</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseEntryToRelease</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleaseOrder" name="שחרור ההזמנה לליקוט ועדכון הלקוח והסוכן">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-order-to-fulfilment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReleaseEntryToRelease</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReleasedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OrderReleased" name="ההזמנה שוחררה">
      <bpmn:incoming>Flow_ToReleasedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_RejectEntry" name="ההזמנה לא משוחררת">
      <bpmn:incoming>Flow_RouteAutoReject</bpmn:incoming>
      <bpmn:incoming>Flow_DecisionRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectEntryToNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyRejection" name="עדכון הלקוח והסוכן וסגירת ההזמנה">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-order-not-released" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RejectEntryToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotReleasedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OrderNotReleased" name="ההזמנה לא שוחררה">
      <bpmn:incoming>Flow_ToNotReleasedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToHold" sourceRef="Start_CreditBreach" targetRef="Task_HoldOrder" />
    <bpmn:sequenceFlow id="Flow_HoldToExposure" sourceRef="Task_HoldOrder" targetRef="Task_BuildExposureView" />
    <bpmn:sequenceFlow id="Flow_ExposureToRules" sourceRef="Task_BuildExposureView" targetRef="Rules_CreditRouting" />
    <bpmn:sequenceFlow id="Flow_RulesToRoute" sourceRef="Rules_CreditRouting" targetRef="Gateway_CreditRoute" />
    <bpmn:sequenceFlow id="Flow_RouteAutoApprove" name="אישור אוטומטי" sourceRef="Gateway_CreditRoute" targetRef="Gateway_ReleaseEntry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditRoute.decision = "AUTO_APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteAutoReject" name="דחייה אוטומטית" sourceRef="Gateway_CreditRoute" targetRef="Gateway_RejectEntry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditRoute.decision = "AUTO_REJECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteManual" name="החלטה אנושית" sourceRef="Gateway_CreditRoute" targetRef="Task_CreditDecision" />
    <bpmn:sequenceFlow id="Flow_CreditSlaBreach" sourceRef="Boundary_CreditSla" targetRef="Task_EscalateToCfo" />
    <bpmn:sequenceFlow id="Flow_CfoToEnd" sourceRef="Task_EscalateToCfo" targetRef="End_SlaEscalated" />
    <bpmn:sequenceFlow id="Flow_DecisionMade" sourceRef="Task_CreditDecision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_DecisionApproved" name="אושר" sourceRef="Gateway_Decision" targetRef="Gateway_ReleaseEntry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditDecision = "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DecisionPartial" name="שחרור חלקי" sourceRef="Gateway_Decision" targetRef="Task_ReleasePartial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditDecision = "PARTIAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DecisionRejected" name="נדחה" sourceRef="Gateway_Decision" targetRef="Gateway_RejectEntry" />
    <bpmn:sequenceFlow id="Flow_PartialToRelease" sourceRef="Task_ReleasePartial" targetRef="Gateway_ReleaseEntry" />
    <bpmn:sequenceFlow id="Flow_ReleaseEntryToRelease" sourceRef="Gateway_ReleaseEntry" targetRef="Task_ReleaseOrder" />
    <bpmn:sequenceFlow id="Flow_ToReleasedEnd" sourceRef="Task_ReleaseOrder" targetRef="End_OrderReleased" />
    <bpmn:sequenceFlow id="Flow_RejectEntryToNotify" sourceRef="Gateway_RejectEntry" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_ToNotReleasedEnd" sourceRef="Task_NotifyRejection" targetRef="End_OrderNotReleased" />
  </bpmn:process>
  <bpmn:message id="Message_CreditLimitBreached" name="credit-limit-breached" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CreditExceptionApproval">
      <bpmndi:BPMNShape id="Start_CreditBreach_di" bpmnElement="Start_CreditBreach">
        <dc:Bounds x="152" y="222" width="36" height="36" />
